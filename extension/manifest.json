{
  "manifest_version": 3,
  "name": "PhishShield AI - Zero Trust",
  "version": "1.0",
  "description": "Real-time deep learning phishing detection. Blocks access to dangerous login pages.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield AI"
  }
}
